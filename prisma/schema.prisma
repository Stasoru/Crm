generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum MessageDirection {
  IN
  OUT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Company {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  contacts      Contact[]
  pipelines     Pipeline[]
  deals         Deal[]
  products      Product[]
  tasks         Task[]
  channels      Channel[]
  conversations Conversation[]
  activities    Activity[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  ownedContacts Contact[]
  ownedDeals    Deal[]
  tasks         Task[]
  conversations Conversation[]
  activities    Activity[]
}

model Membership {
  id        String  @id @default(cuid())
  role      Role    @default(SELLER)
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Contact {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  phone         String?
  email         String?
  source        String?
  tags          String[]
  ownerId       String?
  createdAt     DateTime       @default(now())
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  deals         Deal[]
  tasks         Task[]
  conversations Conversation[]
  activities    Activity[]

  @@unique([companyId, phone])
  @@index([companyId, createdAt])
}

model Pipeline {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@index([pipelineId, position])
}

model Deal {
  id             String         @id @default(cuid())
  companyId      String
  pipelineId     String
  stageId        String
  contactId      String
  ownerId        String?
  title          String
  value          Decimal        @default(0) @db.Decimal(12, 2)
  status         DealStatus     @default(OPEN)
  lostReason     String?
  stageEnteredAt DateTime       @default(now())
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline       Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  products       DealProduct[]
  tasks          Task[]
  activities     Activity[]

  @@index([companyId, pipelineId, status])
}

model Product {
  id        String        @id @default(cuid())
  companyId String
  name      String
  price     Decimal       @default(0) @db.Decimal(12, 2)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals     DealProduct[]
}

model DealProduct {
  id        String  @id @default(cuid())
  dealId    String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  dueAt       DateTime?
  doneAt      DateTime?
  assigneeId  String?
  contactId   String?
  dealId      String?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId, doneAt, dueAt])
}

// A messaging connection. Only WhatsApp Cloud API for now.
model Channel {
  id            String         @id @default(cuid())
  companyId     String
  kind          String         @default("whatsapp")
  name          String
  phoneNumberId String         @unique
  accessToken   String
  verifyToken   String
  createdAt     DateTime       @default(now())
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

model Conversation {
  id            String             @id @default(cuid())
  companyId     String
  channelId     String
  contactId     String
  assigneeId    String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee      User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([channelId, contactId])
  @@index([companyId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String
  externalId     String?          @unique
  error          String?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Timeline entry shown on contact and deal pages.
model Activity {
  id        String   @id @default(cuid())
  companyId String
  kind      String
  text      String
  userId    String?
  contactId String?
  dealId    String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
}
