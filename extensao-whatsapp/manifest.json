{
  "manifest_version": 3,
  "name": "Beco WppSeller - CRM de vendas para WhatsApp Web",
  "short_name": "Beco WppSeller",
  "version": "1.3.1",
  "description": "CRM para WhatsApp Web: respostas rápidas, agendamentos, funil (CRM), lembretes, envio em massa, robô de atendimento, follow-up, fluxos, IA e backup.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Abrir o WhatsApp Web com o Beco WppSeller"
  },
  "options_page": "pages/painel/index.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "unlimitedStorage",
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "lib/wppconnect-wa.js",
        "content/bridge-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/config.js",
        "shared/storage.js",
        "shared/util.js",
        "content/bridge.js",
        "shared/icons.js",
        "content/ui.js",
        "content/app.js"
      ],
      "css": [
        "content/page.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "content/drawer.css",
        "icons/*.png",
        "icons/*.svg"
      ]
    }
  ]
}